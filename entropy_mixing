def increment_count(key, is_inside):
    idx = 0 if is_inside else 1
    interaction_counts[key][idx] += 1
def mix_entropy(ts):
    # Set the trajectory time step
    universe.trajectory[ts]

    # Extract positions and residue names
    atm_list = [[x, y, resname] for (x, y, _), resname in zip(lpd_atms.positions, lpd_atms.resnames)]

    # Periodic boundary conditions (PBC)
    x_box, y_box = universe.dimensions[:2]
    pbc_offsets = [(0, 0), (x_box, 0), (-x_box, 0), (0, y_box), (0, -y_box),
                    (x_box, y_box), (-x_box, -y_box), (x_box, -y_box), (-x_box, y_box)]
    atm_list_pbc = [
        [atm[0] + dx, atm[1] + dy, atm[2]] 
        for atm in atm_list for dx, dy in pbc_offsets
    ]

    # Prepare Voronoi diagram
    atm_xy = [[atm[0], atm[1]] for atm in atm_list_pbc]
    vor = Voronoi(atm_xy)
    ridge_points = vor.ridge_points

    # reset interaction counter

    initialize_counts()
    # Compute interactions
    for ridge in ridge_points:
        Li, Lj = atm_list_pbc[ridge[0]], atm_list_pbc[ridge[1]] #consecutive points
        in_box = lambda p: 0 < p[0] < x_box and 0 < p[1] < y_box
        is_inside = in_box(Li) and in_box(Lj)
        in_on_box = lambda p: 0 <= p[0] <= x_box and 0 <= p[1] <= y_box
        at_edge = in_on_box(Li) or in_on_box(Lj)
        lipid_pair = sorted([Li[2], Lj[2]])
        key = f"{lipid_pair[0]}_{lipid_pair[1]}"
        if key in interaction_counts:
            if is_inside:
                increment_count(key, True)
            elif at_edge:
                increment_count(key, False)

    # Correct for over-counting at edges
    interaction_totals = {
        key: inside + (edge) / 2
        for key, (inside, edge) in interaction_counts.items()
    }

   
    # Return results
    return universe.trajectory.time, *interaction_totals.values()
